# Create .env.local from this file for local development. Never commit a real key.
GEMINI_API_KEY=

# A stable Gemini model. Override this value when a supported model changes.
GEMINI_MODEL=gemini-2.5-flash

# Per-server-instance safeguards. Use a durable rate limiter before high-traffic launch.
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_DAILY_LIMIT=200
