# Create .env.local from this file for local development. Never commit a real key.
GEMINI_API_KEY=

# Use "vertex" for a Vertex AI Express Mode key, or "vertex-adc" for local
# ADC/service-account credentials. Keep "developer" for a Gemini Developer API key.
GEMINI_BACKEND=developer

# A stable Gemini model. Override this value when a supported model changes.
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# For hosted Vertex ADC mode only. Store this as a sensitive Vercel variable.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Per-server-instance safeguards. Use a durable rate limiter before high-traffic launch.
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_DAILY_LIMIT=200

# Optional semantic RAG with Vertex Vector Search 2.0. Leave RAG_BACKEND=local
# until the collection is populated and Vercel has a service-account credential.
RAG_BACKEND=local
VERTEX_VECTOR_SEARCH_PROJECT=
VERTEX_VECTOR_SEARCH_LOCATION=us-central1
VERTEX_VECTOR_SEARCH_COLLECTION=samuel-portfolio-rag
