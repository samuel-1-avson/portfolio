# Canonical public URL (used for metadata, sitemap, Open Graph and the résumé).
NEXT_PUBLIC_SITE_URL=https://samuel-seven-gamma.vercel.app

# --- Portfolio assistant (all optional; without a key the assistant answers from portfolio data) ---
# Primary Vertex AI API key (express mode) or a Gemini Developer API key.
VERTEX_AI_API_KEY=
GEMINI_API_KEY=

# "vertex" (Vertex AI express mode, default), "vertex-adc" (service account / ADC)
# or "developer" (Gemini Developer API). Inferred from the key when unset.
GEMINI_BACKEND=vertex

# Model and latency controls.
GEMINI_MODEL=gemini-2.5-flash
# Thinking tokens before answering. Defaults to 0 for 2.5 Flash (fastest first token).
GEMINI_THINKING_BUDGET=

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# For hosted vertex-adc mode only. Store as a sensitive environment variable.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Per-instance safeguards. Use a shared store before a high-traffic launch.
CHAT_RATE_LIMIT_PER_MINUTE=10
# Model calls per instance per UTC day; greetings/contact answers do not count.
CHAT_DAILY_LIMIT=300

# Optional semantic retrieval with Vertex AI Vector Search 2.0. Leave RAG_BACKEND=local
# until the collection is synced (npm run rag:sync) and the host has a service account.
RAG_BACKEND=local
VERTEX_VECTOR_SEARCH_PROJECT=
VERTEX_VECTOR_SEARCH_LOCATION=us-central1
VERTEX_VECTOR_SEARCH_COLLECTION=samuel-portfolio-rag

# --- Maintenance scripts ---
# Optional token for `npm run github:sync` (raises the GitHub API rate limit).
GITHUB_TOKEN=
